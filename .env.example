# Environment Configuration Template
# IMPORTANT: DO NOT commit your actual secrets/keys into version control.

# Hugging Face Access (for DINOv3 model weights / checkpoints)
HF_TOKEN=

# Kaggle API Credentials (for publishing datasets / running Kaggle CLI)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Docker Hub Credentials (for image publishing)
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Data & Model Storage Paths
DATA_RAW_DIR=./data/raw
DATA_SAMPLE_DIR=./data/sample
CHECKPOINT_DIR=./checkpoints
OUTPUT_DIR=./artifacts

# Application Settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

